#include <stdio.h>

int main() {
    long long int largeInteger = 123456789012345LL; // A large integer
    double largeDouble = 123456789012345.678; // A large double-precision floating-point number
    char character = 'A'; // A single character
    char string[] = "Hello, World!"; // A string (array of characters)

    printf("Large Integer: %lld\n", largeInteger);
    printf("Large Double: %lf\n", largeDouble);
    printf("Character: %c\n", character);
    printf("String: %s\n", string);

    return 0;
}

