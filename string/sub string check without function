#include <stdio.h>
#include <string.h>

int main() {
    const char *mainString = "Hello, World!";
    const char *substring = "World";

    // Find the first occurrence of the substring in the mainString
    char *result = strstr(mainString, substring);

    if (result) {
        printf("Substring found at position: %ld\n", result - mainString);
    } else {
        printf("Substring not found.\n");
    }

    return 0;
}
