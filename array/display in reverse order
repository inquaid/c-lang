#include <stdio.h>
#define n 5
void scan(int *ary, int a)
{
  for (int i = 0; i < a; i++)
  {
    scanf("%d", &ary[i]);
  }
}
void print(int *ary, int b)
{
  for (int i = 0; i < b; i++)
  {
    printf("%d ", ary[i]);
  }
}

int main()
{
  int ary[n], arr[n];
  scan(ary, n);

  for (int i = 0, j = n - 1; i < n, j >= 0; i++, j--)
  {

    arr[j] = ary[i];
  }

  print(arr, n);

  return 0;
}
