#include <stdio.h>
#define n 10
void scan(int *ary, int a)
{
  for (int i = 0; i < a; i++)
    scanf("%d", &ary[i]);
}

void print(int *arr, int b)
{
  for (int i = 0; i < b; i++)
  {
    printf("%d ", arr[i]);
  }
}

void check(int *ary, int c)
{
  int j;
  int max = ary[0];
  for (int i = 0; i < c; i++)
  {
    for (j = 0; j < c; j++)
    {
      if (max < ary[j])  //if (max > ary[j]) for min
         max = ary[j];
    }
  }
  printf("%d", max);
}

int main()
{
  int ary[n];
  scan(ary, n);
  check(ary, n);
  return 0;
}
