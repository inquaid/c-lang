#include <stdio.h>
#include <stdbool.h>
#include <math.h>

void seiveP(int a)
{

    bool isPrime[a + 1];
    for (int i = 0; i <= a; i++)
    {
        isPrime[i] = true;
    }
    isPrime[0] = isPrime[1] = false;

    for (int k = 2; k * k <= a; k++)
    {
        if (isPrime[k])
        {
            for (int i = k * k; i <= a; i = i + k)
            {
                isPrime[i] = false;
            }
        }
    }
    int count = 0;
    for (int i = 0; i <= a; i++)
    {
        if (isPrime[i])
        {
            printf("%d ", i);
        }
    }
}

int main()
{
    int a;
    scanf("%d", &a);
    seiveP(a);

    return 0;
}
