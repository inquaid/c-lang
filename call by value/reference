#include <stdio.h>
void ab(int a, int b)
{
  a = 10, b = 30;
  printf("%d %d\n", a, b); // call by value
}

void ab1(int *a, int *b)
{
  *a = 10, *b = 30;
  printf("%d %d\n", *a, *b); // call by reference
}

int main()
{
  int a = 12, b = 23;
  printf("%d %d\n", a, b);

  ab(a, b);
  printf("%d %d\n", a, b);

  ab1(&a, &b);
  printf("%d %d\n", a, b);
}
