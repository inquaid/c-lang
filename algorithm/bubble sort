#include <stdio.h>
void sort(int *ary, int size)
{
  for (int i = 0; i < size - 1; i++)
  {
    for (int j = 0; j < size - 1; j++)
    {
      if (ary[j] > ary[j + 1])
      {
        int temp = ary[j];
        ary[j] = ary[j + 1];
        ary[j + 1] = temp;
      }
    }
  }

  int i = 0;
  while (i < size)
  {

    printf("%d ", ary[i]);
    i++;
  }
}

int main()
{
  int ary[] = {1, 2, 3, 32, 132, 124, 3, 33, 23, 4};
  int size = sizeof(ary) / sizeof(ary[0]);
  sort(ary, size);
}
