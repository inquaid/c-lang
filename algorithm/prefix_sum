// prefix sum
// formula 1: pref[i] = pref[i-1] + a[i-1];
// formula 2: sum(L...R) = pref[R+1] - pref[L];

#include <stdio.h>
int main()
{
  int ary[] = {1, 2, 3, 4, 5, 6, 7, 8, 90};
  int prefix_sum[132];
  prefix_sum[0] = 0;

  for (int i = 1; i <= 9; i++)
  {
    prefix_sum[i] = prefix_sum[i - 1] + ary[i - 1];
  }
  for (int i = 0; i <= 9; i++)
  {
    printf("%d ", prefix_sum[i]);
  }
}
