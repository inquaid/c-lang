// the array must be sorted before using binary search

#include <stdio.h>

int binarySearch(int *ary, int size, int target)
{
  int low = 0;
  int high = size - 1;

  while (low <= high)
  {
    int mid = (low + high)/ 2;

    if (ary[mid] == target)
    {
      return mid;
    }

    if (ary[mid] > target)
    {
      high = mid - 1;
    }
    if (ary[mid] < target)
    {
      low = mid + 1;
    }
  }
  return 0;
}

int main()
{
  int ary[] = {2, 3, 5, 6, 8, 9, 13, 16, 21, 24};
  int size = sizeof(ary) / sizeof(ary[0]);
  int target = 13;
  int result = binarySearch(ary, size, target);
  if (!result)
    printf("not found");
  else
    printf("%d", result);
  return 0;
}









//another example
int binary_search(int ary[], int n, int target)
{
    int low = 0;
    int high = n - 1;
    while (low <= high)
    {
        int mid = (low + high) / 2;
        int midvalue = ary[mid];
        if (midvalue == target)
            return mid;
        else if (midvalue < target)
        {
            low = mid + 1;
        }
        else
        {
            high = mid - 1;
        }
    }
    return -1;
}


